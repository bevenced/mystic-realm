# DeepSeek API
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# PayPal
# Use PAYPAL_MODE=sandbox for testing, PAYPAL_MODE=live for production
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=live

# Clerk (get these from https://clerk.com)
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Vercel Postgres (get from Vercel Dashboard > Storage > Postgres)
POSTGRES_URL=postgresql://user:password@host:5432/database?sslmode=require
POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/database?sslmode=require&pgbouncer=true
POSTGRES_URL_NO_SSL=postgresql://user:password@host:5432/database
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/database?sslmode=require
POSTGRES_USER=user
POSTGRES_HOST=host
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=database

# Public (exposed to browser)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
NEXT_PUBLIC_SITE_URL=http://localhost:3001
