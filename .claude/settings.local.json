{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${HOME}/.claude/plugins/marketplaces/claude-plugins-official/plugins/superpowers/hooks/run-hook.cmd\" session-start",
            "async": false
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:mystic-realm.wentchine.shop)",
      "Bash(npx tsc *)",
      "Bash(npm run *)",
      "Bash(npm install *)",
      "Bash(node scripts/generate-icons.mjs)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(curl -sL https://mystic-realm.wentchine.shop/)"
    ]
  }
}
